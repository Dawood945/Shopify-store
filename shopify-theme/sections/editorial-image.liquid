<section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8 lg:pt-24">
  <div class="relative overflow-hidden rounded-[var(--radius)] bg-surface md:rounded-xl">
    <div class="flex flex-col-reverse md:flex-row">
      <div class="flex flex-1 flex-col justify-center px-6 py-10 md:px-10 lg:px-14 xl:px-20 xl:py-16">
        {% if section.settings.tag != blank %}
          <span class="section-label mb-3 w-fit">{{ section.settings.tag }}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="text-2xl font-bold tracking-tight-headline text-foreground sm:text-3xl lg:text-4xl">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="mt-3 max-w-md text-sm leading-relaxed text-visible-muted sm:text-base">{{ section.settings.description }}</p>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.button_url != blank %}
          <a href="{{ section.settings.button_url }}" class="btn-pill mt-6 w-fit">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
      <div class="relative h-48 overflow-hidden md:h-auto md:w-[45%] lg:w-[50%]">
        <div class="absolute inset-0 bg-gradient-to-t from-surface/60 via-transparent to-transparent md:bg-gradient-to-l md:from-surface/30"></div>
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="h-full w-full object-cover" loading="lazy">
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Editorial Image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Editorial" },
    { "type": "text", "id": "title", "label": "Title", "default": "Editorial Title" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Editorial description text." },
    { "type": "url", "id": "button_url", "label": "Button URL" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Learn More" }
  ],
  "presets": [
    { "name": "Editorial Image", "category": "Home" }
  ]
}
{% endschema %}
