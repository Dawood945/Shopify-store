<div class="relative overflow-hidden rounded-[var(--radius)] bg-surface md:rounded-xl">
  <div class="relative aspect-square overflow-hidden">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" class="h-full w-full object-cover" data-product-image>
    {% else %}
      <div class="flex h-full w-full items-center justify-center bg-surface text-visible-muted">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M3 17l5-5 3 3 4-4 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    {% endif %}
  </div>
  {% if product.images.size > 1 %}
    <div class="flex gap-2 overflow-x-auto p-3">
      {% for image in product.images limit:5 %}
        <button type="button" class="shrink-0 overflow-hidden rounded-[var(--radius)] border-2 transition-colors {% if forloop.first %}border-accent{% else %}border-transparent{% endif %}" data-thumb="{{ forloop.index0 }}">
          <img src="{{ image | image_url: width: 120 }}" alt="{{ product.title | escape }}" class="h-16 w-16 object-cover" loading="lazy">
        </button>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "Product Gallery",
  "presets": [
    { "name": "Product Gallery", "category": "Product" }
  ]
}
{% endschema %}
