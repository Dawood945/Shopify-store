<section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8 lg:pt-24">
  <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <span class="section-label">Trending</span>
      <h2 class="mt-2 text-2xl font-bold tracking-tight-headline text-foreground sm:text-3xl">Top Picks</h2>
      <p class="mt-1 text-sm text-visible-muted">Most wanted products this week</p>
    </div>
    <a href="{{ routes.root_url }}collections/all" class="btn-pill shrink-0">View All</a>
  </div>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {% for block in section.blocks limit:8 %}
      {% render 'product-card', block: block %}
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Trending Grid",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Product Title" },
        { "type": "text", "id": "category", "label": "Category", "default": "Category" },
        { "type": "text", "id": "price", "label": "Price", "default": "$49.99" },
        { "type": "text", "id": "compare_price", "label": "Compare Price" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    { "name": "Trending Grid", "category": "Home" }
  ]
}
{% endschema %}
