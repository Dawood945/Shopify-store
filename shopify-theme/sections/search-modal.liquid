<div x-show="searchOpen" x-cloak class="fixed inset-0 z-[60] flex items-start justify-center bg-background/80 p-4 pt-20 backdrop-blur-sm sm:pt-28" @click.self="searchOpen = false">
  <div class="w-full max-w-xl overflow-hidden rounded-[var(--radius)] border border-border bg-surface shadow-glow" @click.outside="searchOpen = false">
    <div class="flex items-center gap-3 border-b border-border px-4 py-3">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-muted" aria-hidden><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M20 20l-3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      {% comment %}Search input handled by Shopify predictive search{% endcomment %}
      <input type="search" x-ref="searchInput" x-model="searchQuery" placeholder="Search products, categories..." class="flex-1 bg-transparent text-sm outline-none placeholder:text-visible-muted" data-search-input>
      <button type="button" class="btn-icon h-8 w-8" aria-label="Close search" @click="searchOpen = false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div id="search-results">
      <div class="border-t border-border px-4 py-3">
        <a href="{{ routes.root_url }}collections" class="text-xs font-medium text-accent hover:underline">Browse all collections &rarr;</a>
      </div>
    </div>
  </div>
</div>
