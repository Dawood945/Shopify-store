<section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8 lg:pt-24">
  <div class="mb-8">
    <span class="section-label">Categories</span>
    <h2 class="mt-2 text-2xl font-bold tracking-tight-headline text-foreground sm:text-3xl">Shop by Category</h2>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {% for block in section.blocks limit:4 %}
      <a href="{{ block.settings.url | default: '#' }}" class="group relative overflow-hidden rounded-[var(--radius)] bg-surface transition-shadow hover:shadow-glow md:rounded-xl">
        <div class="relative aspect-[4/3] overflow-hidden">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
          {% endif %}
          <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-surface/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <h3 class="text-lg font-bold text-foreground">{{ block.settings.title }}</h3>
            {% if block.settings.count != blank %}
              <p class="mt-0.5 text-xs text-visible-muted">{{ block.settings.count }}</p>
            {% endif %}
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Category Tiles",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "text", "id": "count", "label": "Count", "default": "12 items" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    { "name": "Category Tiles", "category": "Home" }
  ]
}
{% endschema %}
