<div class="space-y-3">
  <h3 class="text-lg font-bold text-foreground">FAQ</h3>
  {% for block in section.blocks %}
    <div class="rounded-[var(--radius)] border border-border bg-surface">
      <button type="button" data-faq-toggle class="flex w-full items-center justify-between px-4 py-3 text-left text-sm font-medium text-foreground">
        <span>{{ block.settings.question }}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="shrink-0 text-visible-muted transition-transform"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div data-faq-panel class="hidden border-t border-border px-4 pb-3 pt-2 text-sm text-visible-muted">
        {{ block.settings.answer }}
      </div>
    </div>
  {% endfor %}
</div>
{% schema %}
{
  "name": "Product FAQ",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Answer." }
      ]
    }
  ],
  "presets": [
    { "name": "Product FAQ", "category": "Product" }
  ]
}
{% endschema %}
