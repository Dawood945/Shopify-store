<section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8 lg:pt-24">
  <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <span class="section-label">Bundle Up</span>
      <h2 class="mt-2 text-2xl font-bold tracking-tight-headline text-foreground sm:text-3xl">Smart Bundles</h2>
      <p class="mt-1 text-sm text-visible-muted">Hand-picked combos with instant discounts</p>
    </div>
    <a href="/pages/bundles" class="btn-pill shrink-0">View All Bundles</a>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for block in section.blocks limit:3 %}
      {% render 'bundle-card', block: block %}
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Bundle Deals",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Bundle Title" },
        { "type": "text", "id": "items", "label": "Items", "default": "3 Items" },
        { "type": "text", "id": "price", "label": "Price", "default": "$149.99" },
        { "type": "text", "id": "compare_price", "label": "Compare Price", "default": "$199.99" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    { "name": "Bundle Deals", "category": "Home" }
  ]
}
{% endschema %}
