<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="coffee" class="h-full antialiased">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script>
    (function(){try{var t=localStorage.getItem("chat-theme")||"coffee";document.documentElement.setAttribute("data-theme",t);}catch(e){}})();
    window.addEventListener("storage",function(e){if(e.key==="chat-theme")document.documentElement.setAttribute("data-theme",e.newValue||"coffee");});
    window.addEventListener("chat-theme-change",function(e){if(e.detail&&e.detail.theme)document.documentElement.setAttribute("data-theme",e.detail.theme);});
  </script>
</head>
<body class="min-h-dvh bg-background text-foreground" x-data="{ searchOpen: false, cartOpen: false }" x-cloak>
  {% section 'header' %}
  <main class="flex-1 footer-clearance lg:pb-0">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% section 'mobile-bottom-nav' %}
  {% section 'search-modal' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
