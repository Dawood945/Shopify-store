<div class="relative">
  <button type="button" class="btn-icon relative" aria-label="Theme" data-theme-toggle>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>
  <div class="absolute right-0 top-full z-50 mt-2 hidden w-44 overflow-hidden rounded-[var(--radius)] border border-border bg-surface shadow-glow">
    {% assign themes = "zinc,slate,stone,gray,neutral,red,rose,orange,green,blue,yellow,violet" | split: "," %}
    {% for theme in themes %}
      <button type="button" data-theme-swatch="{{ theme }}" class="flex w-full items-center gap-3 px-4 py-2.5 text-xs font-medium text-foreground transition-colors hover:bg-accent-muted">
        <span class="flex h-4 w-4 rounded-full border border-border" style="background-color:var(--color-{{ theme }}-500)"></span>
        {{ theme | capitalize }}
      </button>
    {% endfor %}
  </div>
</div>
