<a href="{{ product.url | default: block.settings.url | default: '#' }}" class="group flex flex-col overflow-hidden rounded-[var(--radius)] border border-border bg-surface transition-all hover:shadow-glow md:rounded-xl">
  <div class="relative aspect-square overflow-hidden bg-surface">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
    {% elsif block.settings.image %}
      <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
    {% else %}
      <div class="flex h-full w-full items-center justify-center text-visible-muted">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M3 17l5-5 3 3 4-4 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    {% endif %}
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    {% if product.type != blank or block.settings.category != blank %}
      <span class="text-[10px] font-semibold uppercase tracking-widest text-accent">{{ product.type | default: block.settings.category }}</span>
    {% endif %}
    <h3 class="text-sm font-semibold text-foreground group-hover:text-accent">{{ product.title | default: block.settings.title }}</h3>
    <div class="mt-auto flex items-baseline gap-2 pt-2">
      <span class="text-sm font-bold text-foreground">{{ product.price | default: block.settings.price | money }}</span>
      {% if product.compare_at_price > product.price or block.settings.compare_price != blank %}
        <span class="text-xs text-visible-muted line-through">{{ product.compare_at_price | default: block.settings.compare_price | money }}</span>
      {% endif %}
    </div>
  </div>
</a>
