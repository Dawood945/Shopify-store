<ul class="flex items-center gap-1">
  {% for link in linklists.main-menu.links %}
    <li>
      <a href="{{ link.url }}" class="rounded-[var(--radius)] px-3 py-2 text-[12px] font-semibold transition-colors text-visible-muted hover:bg-surface hover:text-foreground">{{ link.title }}</a>
    </li>
  {% endfor %}
</ul>
