<a href="{{ block.settings.url | default: '#' }}" class="group flex flex-col overflow-hidden rounded-[var(--radius)] border border-border bg-surface transition-all hover:shadow-glow md:rounded-xl">
  <div class="relative aspect-[4/3] overflow-hidden">
    <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
    <div class="absolute inset-0 bg-gradient-to-t from-surface/60 via-transparent to-transparent"></div>
    <span class="absolute left-3 top-3 rounded-full bg-accent px-2.5 py-0.5 text-[10px] font-bold text-accent-foreground">Bundle</span>
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <span class="text-[10px] font-semibold uppercase tracking-widest text-accent">{{ block.settings.items }}</span>
    <h3 class="text-sm font-semibold text-foreground group-hover:text-accent">{{ block.settings.title }}</h3>
    <div class="mt-auto flex items-baseline gap-2 pt-2">
      <span class="text-sm font-bold text-foreground">{{ block.settings.price }}</span>
      {% if block.settings.compare_price != blank %}
        <span class="text-xs text-visible-muted line-through">{{ block.settings.compare_price }}</span>
      {% endif %}
    </div>
  </div>
</a>
